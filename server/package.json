{
  "name": "hazmat-response-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hazmat Response Support backend: Hono REST API + Drizzle ORM + MariaDB/SQLite.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:init-sqlite": "tsx src/init-sqlite.ts",
    "db:seed": "tsx src/seed.ts",
    "chemicals:audit": "node --import tsx src/audit-chemical-companion.ts",
    "safety-data:audit": "node --import tsx src/audit-safety-data.ts",
    "chemicals:rebuild": "node --import tsx --input-type=module -e \"import { rebuildCompanionSearchIndex } from './src/chemical-companion.ts'; console.log(rebuildCompanionSearchIndex())\"",
    "chemicals:export-unlinked": "node --import tsx src/export-unlinked-chemical-companion.ts",
    "db:studio": "drizzle-kit studio",
    "scrape:tier2": "tsx scripts/tier2-scraper.ts",
    "import:tier2-facilities": "node --import tsx src/import-tier2-facilities.ts",
    "import:tier2-details": "node --import tsx src/import-tier2-details.ts",
    "verify:tier2-links": "node --import tsx src/verify-tier2-links.ts",
    "plume:validation": "node --import tsx src/validate-plume-model.ts",
    "plume:validation:gate": "node --import tsx src/validate-plume-model.ts --require-validated",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
