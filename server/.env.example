# Hazmat Response Support — server environment.
# Copy to .env and edit. Do NOT commit the real .env.

# API port (default 3000).
PORT=3000

# SQLite database file path (default ./local.db).
# SQLITE_PATH=./local.db

# Live Map primary visual radar. NOAA/NWS MRMS is the built-in fallback.
# RainViewer remains an opt-in visual prototype pending licensing review.
# ENABLE_RAINVIEWER_RADAR=false

# NASA FIRMS MAP_KEY for server-side active fire detection queries.
# Request at https://firms.modaps.eosdis.nasa.gov/usfs/api/map_key/
NASA_FIRMS_MAP_KEY=
