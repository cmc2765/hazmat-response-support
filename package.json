{
  "name": "hazmat-response-support",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared data pipeline, model math, and schema for the Hazmat Response Support app (UI + API live in /server). Chemical lookup, plume modeling, NIOSH data, Tier II facilities.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample:mock": "node sample/mock-server/server.js",
    "sample:client": "node sample/integration-sample/client.js",
    "sample:all": "node sample/mock-server/server.js & npm run sample:client"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2",
    "ws": "^8.21.0"
  }
}
