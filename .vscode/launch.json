{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start HazMatIQ Preview",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "outputCapture": "std",
      "serverReadyAction": {
        "pattern": ".*Hono API listening on http://localhost:([0-9]+).*$",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
