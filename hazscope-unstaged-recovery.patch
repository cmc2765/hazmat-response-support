+/* Chemical Profile visual system — shared shell, hero, tab nav, cards, guidance,
+   metrics, source summary, and empty state. */
+.chemical-profile-shell {
+  font-family: var(--hazmatiq-font-body);
+}
+
+.chemical-profile-header-card {
+  position: relative;
+  isolation: isolate;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  grid-template-areas:
+    "heading actions"
+    "summary actions"
+    "meta actions";
+  align-items: center;
+  gap: 8px 20px;
+  padding: 18px 20px;
+  overflow: hidden;
+  border: 1px solid #356a94;
+  border-radius: 16px;
+  background:
+    radial-gradient(circle at 82% 18%, rgba(246, 195, 67, 0.18), transparent 28%),
+    linear-gradient(135deg, #123f67 0%, #0b2d4b 68%, #071f36 100%);
+}
+
+.chemical-profile-header-card::before {
+  content: "";
+  position: absolute;
+  z-index: -1;
+  inset: 0 0 0 58%;
+  opacity: 0.24;
+  background-image:
+    linear-gradient(30deg, transparent 48%, rgba(220, 239, 255, 0.42) 49%, rgba(220, 239, 255, 0.42) 51%, transparent 52%),
+    linear-gradient(150deg, transparent 48%, rgba(220, 239, 255, 0.32) 49%, rgba(220, 239, 255, 0.32) 51%, transparent 52%);
+  background-size: 42px 72px;
+  mask-image: linear-gradient(to left, #000, transparent);
+}
+
+.chemical-profile-header-top { grid-area: heading; }
+.chemical-profile-summary { grid-area: summary; max-width: 780px; font-size: 0.92rem; }
+.chemical-profile-meta { grid-area: meta; }
+.chemical-profile-actions {
+  grid-area: actions;
+  max-width: 410px;
+  justify-content: flex-end;
+}
+
+.chemical-profile-status-chip {
+  display: inline-flex;
+  align-items: center;
+  min-height: 28px;
+  padding: 4px 9px;
+  border: 1px solid rgba(246, 195, 67, 0.74);
+  border-radius: 999px;
+  color: #fff5c2;
+  background: rgba(7, 31, 54, 0.7);
+  font-size: 0.74rem;
+  font-weight: 700;
+  white-space: nowrap;
+}
+
+.chemical-profile-status-chip[data-state="verified"]::before {
+  content: "";
+  width: 7px;
+  height: 7px;
+  margin-right: 6px;
+  border-radius: 50%;
+  background: #70d59b;
+  box-shadow: 0 0 0 3px rgba(112, 213, 155, 0.15);
+}
+
+.chemical-profile-layout {
+  gap: 12px;
+  padding: 0;
+}
+
+.chemical-profile-tabs {
+  grid-template-columns: repeat(11, minmax(112px, 1fr));
